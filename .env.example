# SITE_ENV: "staging" (default, fail-safe) or "production".
# Production only counts when VERCEL_ENV is also "production" (or unset, for local builds).
SITE_ENV=staging
# Honoured only in production. Staging always builds without tracking.
ENABLE_TRACKING=false
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/nekov/nekov-s-week
# Test-mode Payment Link on staging, live link in production.
STRIPE_SESSION_LINK=
# Optional basic-auth fallback when Vercel Deployment Protection is unavailable.
STAGING_USER=
STAGING_PASS=
# FormSubmit alias (from the activation email). Delivers contact-form mail to Nikolay. Server only.
FORMSUBMIT_ALIAS=
# Optional: where the local JSONL copy goes (default ./data, /tmp on Vercel).
LEADS_DIR=

# Tracking IDs (only used when SITE_ENV=production and ENABLE_TRACKING=true). Current site values:
# GA4_ID=G-2LN9KW0W9H
# FB_PIXEL_ID=1037052426704490
GA4_ID=
FB_PIXEL_ID=

# ── Apply page (questionnaire) ───────────────────────────────────────────
# Supabase (server only). Without these the app stores to local JSON files (development only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Signs the "see my result again" links. Required in production.
APPLY_SECRET=
# n8n sends the owner notification and the visitor's confirmation email. HMAC-signed webhook.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Cloudflare Turnstile (required in production; submit fails closed without it).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
APPLY_BASE_URL=https://www.nekov.com
APPLY_ADMIN_URL=https://www.nekov.com
# Price ladder above the budget question. Amounts are placeholders until the owner supplies them.
SHOW_PRICE_LADDER=false
