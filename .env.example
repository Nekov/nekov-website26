# SITE_ENV: "staging" (default, fail-safe) or "production".
# Production only counts when VERCEL_ENV is also "production" (or unset, for local builds).
SITE_ENV=staging
# Honoured only in production. Staging always builds without tracking.
ENABLE_TRACKING=false
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/nekov/nekov-s-week
# Test-mode Payment Link on staging, live link in production.
STRIPE_SESSION_LINK=
# Optional basic-auth fallback when Vercel Deployment Protection is unavailable.
STAGING_USER=
STAGING_PASS=
